# SQLite file. Relative paths resolve from the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Populate an empty database with the 4 templates + sample responses on first boot.
SEED_DEMO_DATA="true"

# Pool of dedicated per-form ports. Each new form is assigned the next free one and
# served there at "/". Publish the same range in docker-compose.yml. Leave empty to disable.
FORM_PORT_RANGE="4001-4050"

# Where uploaded logos/cover images are stored (defaults to ./data/uploads).
# UPLOAD_DIR="/app/data/uploads"
